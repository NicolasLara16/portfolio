# ============================================================
# CONFIGURAÇÃO DO FIREBASE
# Copie este arquivo para .env.local e preencha com as credenciais
# do seu projeto (Console Firebase → Configurações do projeto →
# Seus apps → SDK setup and configuration).
# ============================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL pública do site (usada nas meta tags de SEO/compartilhamento).
# Em produção (ex.: Vercel), defina como https://seudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# SOMENTE PARA O SCRIPT DE SEED (npm run seed)
# Use a MESMA conta de administrador criada no Firebase Authentication.
# Nunca faça commit destas credenciais.
# ============================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
