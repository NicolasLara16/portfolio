rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "pjjVKJ35r8RDuzeHfPiPKsBmgvU2";
    }

    // Leitura pública, escrita apenas pelo admin
    match /profile/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /skills/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /softSkills/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /certifications/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Qualquer outra coleção: acesso negado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
