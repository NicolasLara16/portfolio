rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Certificados: leitura pública (links "Ver Certificado"),
    // escrita restrita ao admin, com limite de tamanho e tipo
    match /certificates/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "pjjVKJ35r8RDuzeHfPiPKsBmgvU2"
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('image/.*'));
    }

    // Qualquer outro caminho: acesso negado por padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
